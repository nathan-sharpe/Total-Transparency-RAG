# Copy to .env and fill in real values. Never commit .env.
# Every value below has a working default in rag/config.py; only POSTGRES_USER
# and POSTGRES_PASSWORD are required. The rest are shown so the knobs are
# discoverable — uncomment to override.

# Postgres — docker compose uses these to create the database; the app uses them to connect
POSTGRES_USER=rag
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=rag
DB_HOST=localhost
DB_PORT=5432

# Ollama server (native on the Windows host; from inside containers use http://host.docker.internal:11434)
OLLAMA_URL=http://localhost:11434

# Logging threshold: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Embedding profile: "sentence-transformers" (all-MiniLM-L6-v2, CPU) is the adopted
# default — Phase 6 experiments showed it beats nomic on SciFact (see EVALS.md), and CI
# uses it too. "ollama" (nomic-embed-text) was the original local-Ollama profile.
# Generation and judging stay on local Ollama regardless of this setting.
EMBEDDING_PROFILE=sentence-transformers

# --- Optional overrides (defaults shown; uncomment to change) ---

# Chunking (measured in words, not tokens). 300/60 is the Phase 6 chunk-sweep winner.
#CHUNK_SIZE=300
#CHUNK_OVERLAP=60

# Retrieval
#TOP_K=5

# Guardrail 2 (no-answer path): min cosine similarity of the best retrieved chunk
# before the system answers instead of refusing. PROFILE-SPECIFIC — 0.36 for the
# adopted sentence-transformers profile (was 0.60 for nomic/ollama). See EVALS.md.
#NO_ANSWER_THRESHOLD=0.36

# Generation model + resource guardrails (guardrail 4)
#GENERATOR_MODEL=llama3.1:8b
#GENERATOR_TEMPERATURE=0.0
#GENERATION_TIMEOUT_SECONDS=120.0
#EMBED_TIMEOUT_SECONDS=60.0
#MAX_CONTEXT_CHUNKS=5
#MAX_OUTPUT_TOKENS=512

# Input guardrail (guardrail 1) — API query length cap
#MAX_QUERY_CHARS=2000

# API server bind address (python main.py). When running under docker compose,
# API_PORT is also the host port the container is published on.
#API_HOST=127.0.0.1
#API_PORT=8000

# Backstop notification (Phase 4): a Slack or Discord incoming-webhook URL.
# When set, the API's global exception handler posts a short alert there
# (error id + route only — never the stack trace or exception message).
#ERROR_WEBHOOK_URL=
#WEBHOOK_TIMEOUT_SECONDS=5.0

# When set, the API also writes its log to LOG_DIR/api.log. The compose api
# service sets this to the volume-mounted /app/logs (./logs on the host);
# leave it unset for host-run development (stdout only).
#LOG_DIR=
