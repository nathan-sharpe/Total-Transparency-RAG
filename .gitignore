# --- Secrets & credentials ---
.env
.env.*
# The tracked template is env.example (no leading dot) so it never matches the
# .env.* deny rules above — real secret files stay ignored, the template does not.
!env.example
*.pem
*.key
secrets/
credentials.json

# --- Claude Code (personal/local config) ---
.claude/settings.local.json

# --- Node.js ---
node_modules/
npm-debug.log*

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Build output ---
dist/
build/

# --- Data downloads (SciFact corpus etc.) ---
data/

# --- Logs & databases ---
*.log
*.sqlite

# --- Eval intermediates ---
# answers.json is the bulky pass-1 safety artifact (full chunk texts) written
# between the generate and judge passes; the committed result is generation.json.
evals/results/answers.json

# --- OS junk ---
Thumbs.db
Desktop.ini
.DS_Store

# --- IDE ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json